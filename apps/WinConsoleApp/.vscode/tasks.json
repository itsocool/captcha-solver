{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "configure",
			"type": "shell",
			"command": "cmake",
			"args": ["-B", "build", "-G", "Visual Studio 17 2022", "-A", "x64"],
			"problemMatcher": [],
			"presentation": { "reveal": "silent" }
		},
		{
			"label": "build",
			"type": "shell",
			"command": "cmake",
			"args": ["--build", "build", "--config", "Release"],
			"dependsOn": "configure",
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": "$msCompile"
		},
		{
			"label": "test",
			"type": "shell",
			"command": "ctest",
			"args": ["--test-dir", "build", "-C", "Release", "--output-on-failure"],
			"dependsOn": "build",
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "cmake",
			"args": ["-E", "rm", "-rf", "build"],
			"problemMatcher": []
		}
	]
}
