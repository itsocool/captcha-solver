# Example .env for hyper-captcha-resolver
# Default captcha id used when none specified in the form
DEFAULT_CAPTCHA_ID=supreme_court

# 앱 표시 버전 — 이미지 재빌드 없이 이 값만 고치고 docker compose up -d 하면 반영된다.
APP_VERSION=0.8

# App host/port/debug (환경 변수 접두사: WEB_ 로 변경됨)
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=true

# 리버스 프록시 뒤 하위 경로에 물릴 때의 접두사 (예: /captcha). 루트면 비워 둔다.
WEB_CONTEXT_PATH=

# SQLite database used by the FastAPI backend
DB_DRIVER=sqlite3
DB_PATH=./db/captchaSolver.sqlite3
DB_URL=sqlite:///./db/captchaSolver.sqlite3
DB_SCHEMA_PATH=./db/schema.sql
DB_SEED_PATH=./db/seed_captcha_types.sql

# 기타: 필요시 추가 환경변수를 여기서 정의하세요
